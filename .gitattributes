# Text is normalized to LF in the repository and in every checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diffed, never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.riv binary
*.lottie binary

# Lockfiles: collapsed in diffs, never hand-merged.
bun.lock linguist-generated=true
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff
uv.lock linguist-generated=true -diff
pubspec.lock linguist-generated=true -diff
Package.resolved linguist-generated=true -diff
