{
  "name": "@sxnnyside/circe",
  "version": "1.1.0",
  "description": "Inversion-of-control framework for discord.js bots: file-system conventions, declarative config, guards, i18n and Gateway or HTTP transport. Runs on Bun, Node.js 22+ and Deno.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxnnyside-project/circe.git"
  },
  "homepage": "https://github.com/sxnnyside-project/circe#readme",
  "bugs": {
    "url": "https://github.com/sxnnyside-project/circe/issues"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "framework",
    "bun",
    "node",
    "deno",
    "typescript",
    "sxnnyside"
  ],
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.4.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "circe": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./bun-sqlite": {
      "types": "./dist/bun-sqlite.d.ts",
      "import": "./dist/bun-sqlite.js",
      "default": "./dist/bun-sqlite.js"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "rm -rf dist && bun build ./src/index.ts ./src/testing/index.ts ./src/cli/index.ts ./src/bun-sqlite.ts --outdir ./dist --target node --format esm --splitting --external discord.js --sourcemap=external --chunk-naming 'chunks/[name]-[hash].[ext]' && tsc -p tsconfig.build.json --emitDeclarationOnly && chmod +x ./dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun scripts/coverage.ts",
    "bench": "bun scripts/bench/run.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build && bun run test:coverage",
    "clean": "rm -rf dist dist-node",
    "prepare": "husky",
    "prepublishOnly": "bun run check",
    "lint:fix": "biome lint --write .",
    "build:node": "tsc -p tsconfig.node.json"
  },
  "peerDependencies": {
    "discord.js": "^14.16.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.3.14",
    "@types/node": "26.6.5",
    "discord.js": "14.27.0",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "zod": "4.6.6"
  },
  "packageManager": "bun@1.4.0",
  "author": {
    "name": "Sxnnyside Project",
    "url": "https://github.com/sxnnyside-project"
  }
}
