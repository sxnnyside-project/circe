{
  "name": "@sxnnyside/circe",
  "version": "1.0.0",
  "description": "TypeScript/Bun-first Discord bot framework for the Sxnnyside Project ecosystem.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxnnyside-project/circe.git"
  },
  "homepage": "https://github.com/sxnnyside-project/circe#readme",
  "bugs": {
    "url": "https://github.com/sxnnyside-project/circe/issues"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "framework",
    "bun",
    "node",
    "deno",
    "typescript",
    "sxnnyside"
  ],
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.4.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "circe": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./bun-sqlite": {
      "types": "./dist/bun-sqlite.d.ts",
      "import": "./dist/bun-sqlite.js",
      "default": "./dist/bun-sqlite.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts ./src/testing/index.ts ./src/cli/index.ts ./src/bun-sqlite.ts --outdir ./dist --target node --format esm --splitting --external discord.js && tsc -p tsconfig.build.json --emitDeclarationOnly && chmod +x ./dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun scripts/coverage.ts",
    "bench": "bun scripts/bench/run.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && bun run typecheck && bun run test:coverage && bun run build",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "prepublishOnly": "bun run check"
  },
  "lint-staged": {
    "*.{ts,js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "peerDependencies": {
    "discord.js": "^14.16.0"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "latest",
    "discord.js": "^14.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^5.7.0"
  }
}
